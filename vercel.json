{
  "cleanUrls": true,
  "redirects": [
    { "source": "/demo", "destination": "/", "permanent": false },
    { "source": "/demo/:path*", "destination": "/", "permanent": false }
  ],
  "headers": [
    {
      "source": "/new-parents",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    },
    {
      "source": "/new-parents/(.*)",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    }
  ]
}
